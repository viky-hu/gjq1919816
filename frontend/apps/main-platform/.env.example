# ============================================================
#  Next.js BFF 环境变量模板
#  使用方式：复制为 frontend/apps/main-platform/.env.local
#      cp frontend/apps/main-platform/.env.example \
#         frontend/apps/main-platform/.env.local
#  .env.local 已被 .gitignore 排除，不会进入仓库。
# ============================================================

# ── PostgreSQL（聊天历史持久化，Prisma）────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mia_rag?schema=public

# prisma：强制使用数据库，连接失败直接报错
# auto  ：优先数据库，失败后降级到内存（本地演示推荐）
# mock  ：始终使用内存，重启后丢失
CHAT_HISTORY_STORAGE_MODE=auto

# ── 联邦检索链路 ───────────────────────────────────────────
# 中心聚合服务（frontend/central_server.py，默认 9000 端口）
FEDERATION_CENTRAL_BASE_URL=http://127.0.0.1:9000

# MiA-RAG 主 API（backend/api/main.py，默认 6006 端口）
# 变量名虽然叫 NODE_URL，但 BFF 实际调用的是主 API 上的
# /api/query/internal、/api/sm4/*、/api/graph、/api/macro/* 等路由。
# 6008 的 node_server.py 只负责中心聚合服务的加密 /query。
MIA_RAG_NODE_URL=http://127.0.0.1:6006

# 登录/注册接口（backend/api/main.py，默认 6006 端口）
NEXT_PUBLIC_MIA_RAG_AUTH_URL=http://127.0.0.1:6006

# ── 内部鉴权（必须与 backend/.env 完全一致）────────────────
FEDERATION_INTERNAL_TOKEN=change-me-to-a-random-shared-token
FEDERATION_SM4_KEY=mia-sm4-key-2024
FEDERATION_REQUIRE_TLS=false
FEDERATION_ALLOW_HTTP_LOCALHOST=true

# ── 超时（毫秒）────────────────────────────────────────────
FEDERATION_CENTRAL_TIMEOUT_MS=120000
FEDERATION_CENTRAL_HEALTH_TIMEOUT_MS=5000
FEDERATION_NODE_TIMEOUT_MS=8000

# ── 节点鉴权 ───────────────────────────────────────────────
# 本地演示若遇到 401/403，可临时改为 false + true
NODE_AUTH_STRICT_MODE=true
NODE_AUTH_ALLOW_INSECURE_BYPASS=false
