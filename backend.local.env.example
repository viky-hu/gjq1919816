# Copy this file to backend.local.env only when using local model files.
# Without this file, the launcher uses the model repository IDs below and
# the backend downloads the models on first startup.

# Default remote repositories:
# MODEL_PATH=MindscapeRAG/MiA-Emb-8B
# BASE_MODEL_PATH=Qwen/Qwen3-Embedding-8B

# Example local paths:
# MODEL_PATH=models\MiA-Emb-8B
# BASE_MODEL_PATH=models\Qwen3-Embedding-8B

# Optional LLM configuration:
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# Optional overrides:
# FEDERATION_INTERNAL_TOKEN=mia-federation-internal-token-2024
# JWT_SECRET_KEY=local-dev-jwt-secret-change-me
# FEDERATION_SM4_KEY=mia-sm4-key-2024
