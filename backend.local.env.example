# Copy this file to backend.local.env. Keep API keys private.

# Model repository IDs (downloaded on first backend start):
# MODEL_PATH=MindscapeRAG/MiA-Emb-8B
# BASE_MODEL_PATH=Qwen/Qwen3-Embedding-8B

# Or set local model paths:
# MODEL_PATH=models\MiA-Emb-8B
# BASE_MODEL_PATH=models\Qwen3-Embedding-8B

# OpenAI-compatible LLM provider:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://tokenrhythm.studio/v1
DEEPSEEK_MODEL=deepseek-flash

# Local development overrides (launcher defaults work without uncommenting):
# FEDERATION_INTERNAL_TOKEN=mia-federation-internal-token-2024
# JWT_SECRET_KEY=local-dev-jwt-secret-change-me
# FEDERATION_SM4_KEY=mia-sm4-key-2024
