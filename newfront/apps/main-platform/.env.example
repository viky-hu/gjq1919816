# newfront 前端闭环默认不需要 .env.local。
# 不配置任何变量时：
# - 登录使用演示账号 admin/311311 或 user/123456
# - 聊天历史使用服务端内存 mock
# - 数据库窗口使用 data/database-store.json
# - 外部检索、联邦聚合、宏观接口返回本地演示降级数据

# 可选：真实登录/注册后端。
# NEXT_PUBLIC_MIA_RAG_AUTH_URL=https://example.test

# 可选：MiA-RAG 节点后端，用于真实本地检索、图谱和文件同步。
# MIA_RAG_NODE_URL=https://example.test

# 可选：中心聚合服务，用于 global 模式联邦检索。
# FEDERATION_CENTRAL_BASE_URL=https://example.test

# 可选：聊天历史模式。v1 默认 mock；后续恢复 Prisma 时再切换。
# CHAT_HISTORY_STORAGE_MODE=mock

# 可选：联邦链路与节点鉴权。
# FEDERATION_INTERNAL_TOKEN=replace-with-a-strong-shared-token
# FEDERATION_SM4_KEY=replace-with-your-sm4-key
# FEDERATION_CENTRAL_TIMEOUT_MS=15000
# FEDERATION_CENTRAL_HEALTH_TIMEOUT_MS=5000
# FEDERATION_NODE_HEALTH_URLS=nodea=http://127.0.0.1:8001,nodeb=http://127.0.0.1:8002
# FEDERATION_NODE_TIMEOUT_MS=8000
# NODE_AUTH_STRICT_MODE=true
