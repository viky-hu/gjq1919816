# MiA-RAG Backend — 环境变量模板
# 使用方式：复制为 .env 并填入真实值，与 Python 进程同目录运行
# (set -a; source .env; set +a) 或 Windows: Get-Content .env | ForEach-Object { [System.Environment]::SetEnvironmentVariable(...) }

# ─── 模型配置（队友提供后填入）────────────────────────────────────
# MiA-EMB LoRA 适配器路径或 HuggingFace model ID
MODEL_PATH=MindscapeRAG/MiA-Emb-8B
# 基座模型 Qwen3-Embedding-8B 本地路径（队友提供后填入绝对路径）
BASE_MODEL_PATH=Qwen/Qwen3-Embedding-8B

# ─── 外部 API（队友提供后填入）───────────────────────────────────
# DeepSeek API Key（用于 mindscape 摘要）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ─── 安全与鉴权（必须与前端 .env 保持一致）──────────────────────
# JWT 密钥（改为随机高强度字符串）
JWT_SECRET_KEY=mia-rag-secret-change-in-production

# 联邦 SM4 共享密钥（16 字节，需与 central_server.py 和 Next.js 的 FEDERATION_SM4_KEY 完全一致）
FEDERATION_SM4_KEY=replace-with-your-sm4-key

# 联邦内部鉴权令牌（需与 central_server.py 和 Next.js 的 FEDERATION_INTERNAL_TOKEN 完全一致）
FEDERATION_INTERNAL_TOKEN=replace-with-a-strong-shared-token

# 是否强制要求内部令牌（默认 true，本地调试时可临时设 false）
# FEDERATION_REQUIRE_INTERNAL_TOKEN=true

# ─── 可选：文档自动加载 ──────────────────────────────────────────
# 节点启动时自动加载指定目录下的 .txt 文档
# DOC_DIR=./data

# ─── 启动指令参考 ─────────────────────────────────────────────────
# 节点服务（端口默认 8001，可多实例）：
#   python Encrypted-Smart-Graph.../node_server.py --port 8001
# 中心聚合服务（端口默认 9000）：
#   python central_server.py --port 9000
# 完整 REST API 服务（含 auth/query/documents/nodes）：
#   uvicorn Encrypted-Smart-Graph.../api/main:app --port 8001
