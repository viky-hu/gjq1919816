# ============================================================
#  MiA-RAG 后端环境变量模板（API 模式）
#  使用方式：复制为 backend/.env，再填入真实值
#      cp backend/.env.example backend/.env
#  .env 已被 .gitignore 排除，不会进入仓库。
# ============================================================

# ── LLM（摘要、问答生成）────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Embedding（DashScope OpenAI 兼容接口）───────────────────
# 只要设置 EMBEDDING_API_KEY（或 DASHSCOPE_API_KEY），后端就进入 API 模式，
# 不需要 GPU，也不需要本地模型权重。
DASHSCOPE_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── 鉴权与联邦通信（必须与前端配置一致）────────────────────
JWT_SECRET_KEY=change-me-to-a-random-string
FEDERATION_INTERNAL_TOKEN=change-me-to-a-random-shared-token
# SM4 共享密钥，16 字节；长度不足会自动补齐
FEDERATION_SM4_KEY=mia-sm4-key-2024

# ── LightRAG 词表缓存 ──────────────────────────────────────
# 项目已内置 o200k_base 词表；不填时启动脚本会自动指向 data/tiktoken_cache
# TIKTOKEN_CACHE_DIR=./data/tiktoken_cache

# ── 可选：启动行为 ─────────────────────────────────────────
# 设为 1 时启动不自动导入 data/legal_docs 下的文档
SKIP_DOC_LOAD=1
# 需要自动加载文档时，可改为 0 并指定目录
# DOC_DIR=./data/legal_docs

# ── 可选：视觉模型（图片/视频描述）─────────────────────────
VL_ENABLED=false
VL_MODEL=qwen3-vl-plus
